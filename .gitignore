# berbeda, mis. *.REAL.local.xlsx) tetap ter-ignore.
!data/input/REVENUE FILE.xlsx
!data/input/data target.xlsx
!data/input/data historical.xlsx
!data/input/data_collection.xlsx
!data/input/PRODA FILE.csv
!data/input/PRODB FILE.csv
!data/input/PRODA FILE 2.csv
!data/input/PRODB FILE 2.csv
!data/input/PRODC FILE.csv
